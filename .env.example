# Copy to .env (git-ignored) and set your own password before `docker compose up`.
DB_USERNAME=advising
DB_PASSWORD=change-me
# UP, DOWN, or SLOW. DOWN shows bookings still succeed while notifications fail.
NOTIFICATION_MOCK_MODE=UP
# Optional. Free Gemini API key from https://aistudio.google.com/apikey. Leave empty to run without AI.
GEMINI_API_KEY=
